# =====================================================================
# OEFFENTLICH (auch im Client-Bundle verfuegbar – KEINE Secrets!)
# =====================================================================
NEXT_PUBLIC_SITE_URL=https://example.com

# Wartungsmodus: "true" liefert ausschliesslich die Wartungsseite aus
# (Impressum und Datenschutz bleiben erreichbar). Ohne Angabe gilt der
# Standardwert aus src/lib/maintenance.ts (false).
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Cloudflare Turnstile, Site Key (oeffentlich, gehoert ins Bundle).
# Leer lassen = kein Captcha-Widget. Das Formular funktioniert trotzdem,
# geschuetzt ist es dann nur durch den Honeypot.
# Erzeugt wird das Schluesselpaar im Cloudflare-Dashboard unter Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics, Beacon-Token. Leer lassen = keine Messung und
# kein zusaetzliches Script (siehe src/components/CloudflareAnalytics.tsx).
# Der Dienst ist cookielos und einwilligungsfrei, gehoert aber in die
# Datenschutzerklaerung. Nur fuer Production setzen - sonst zaehlen die
# Vorschau-Deployments mit.
# Wenn der Beacon im Cloudflare-Dashboard automatisch eingespielt wird,
# diesen Wert leer lassen, sonst wird jeder Aufruf doppelt gezaehlt.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# =====================================================================
# SERVER-ONLY (NIE im Client – nicht mit NEXT_PUBLIC_ praefixen!)
# =====================================================================
#
# Diese Werte liest ausschliesslich die Cloudflare Pages Function
# (functions/api/contact.ts). Sie gehoeren NICHT in .env.local, sondern:
#   - lokal   -> .dev.vars (fuer `npx wrangler pages dev out`)
#   - live    -> Cloudflare-Dashboard, Settings > Environment variables
#                (Production und Preview getrennt setzen)
#
# Fehlt einer davon, antwortet das Formular mit "nicht eingerichtet".
# Der Build und `npm run dev` laufen ohne sie durch – Absicht.

# Brevo (Mailversand, EU-Verarbeitung). API-Key v3 aus dem Brevo-Dashboard.
BREVO_API_KEY=
# Im Brevo-Konto verifizierter Absender. Unverifiziert = HTTP 400.
CONTACT_SENDER_EMAIL=
# Anzeigename des Absenders. Ohne Angabe wird CONTACT_SENDER_EMAIL benutzt.
CONTACT_SENDER_NAME=
# Postfach, das die Anfragen empfaengt.
CONTACT_RECEIVER_EMAIL=

# Cloudflare Turnstile, Secret Key. Fehlt er, entfaellt die Captcha-Pruefung
# serverseitig – vor dem Livegang setzen.
TURNSTILE_SECRET_KEY=
